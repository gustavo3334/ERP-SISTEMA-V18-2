APP_NAME=Fácil Pedido ERP
ENVIRONMENT=development
API_PREFIX=/api/v1

# Banco local mais fácil para Windows. Os dados ficam em data/facil_pedido.db
DATABASE_URL=sqlite:///./data/facil_pedido.db

# Para PostgreSQL, comente a linha acima e use:
# DATABASE_URL=postgresql+psycopg://facilpedido:troque_a_senha@localhost:5432/facilpedido

# A tela de login segue desativada durante o desenvolvimento do front-end.
AUTH_DISABLED=true
SECRET_KEY=troque-esta-chave-antes-de-publicar
JWT_ALGORITHM=HS256
ACCESS_TOKEN_MINUTES=480

# Cadastre o administrador apenas quando for reativar o login.
SEED_ADMIN=false
ADMIN_EMAIL=admin@facilpedido.local
ADMIN_PASSWORD=TroqueEstaSenha123!
ADMIN_NAME=Administrador

CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
AUTO_CREATE_TABLES=true
FRONTEND_DIR=frontend

# ============================================================
# ROTAS E GEOCODIFICAÇÃO
# ============================================================
# auto = usa Google quando GOOGLE_MAPS_API_KEY estiver configurada;
#        sem chave, usa OpenStreetMap/Nominatim + OSRM para desenvolvimento.
ROUTE_PROVIDER=auto
GOOGLE_MAPS_API_KEY=
ROUTE_COUNTRY_CODE=br
ROUTE_TIMEOUT_SECONDS=25
ROUTE_USER_AGENT=FacilPedidoERP/1.1
ROUTE_CONTACT_EMAIL=
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
OSRM_BASE_URL=https://router.project-osrm.org

# Backend completo
UPLOAD_DIR=storage/uploads
BACKUP_DIR=backup
MAX_UPLOAD_MB=15
ALLOWED_UPLOAD_EXTENSIONS=.pdf,.png,.jpg,.jpeg,.webp,.doc,.docx,.xls,.xlsx,.csv
COMPANY_ADDRESS=Rodovia João Afonso de Souza Castellano, 1800
REGISTRATION_ALERT_WARNING_DAYS=3
REGISTRATION_ALERT_DANGER_DAYS=5
