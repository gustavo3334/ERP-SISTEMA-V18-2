# Fácil Pedido ERP V18.2 — Vercel + Supabase PostgreSQL
ENVIRONMENT=production
AUTH_DISABLED=false
AUTO_CREATE_TABLES=true

# Recomendado na Vercel: Transaction Pooler do Supabase (porta 6543).
# O backend V18.2 detecta porta 6543 e desativa prepared statements automaticamente.
# O Session Pooler (porta 5432) também é suportado.
DATABASE_URL=postgresql://postgres.PROJECT_REF:SENHA@REGIAO.pooler.supabase.com:6543/postgres?sslmode=require
DATABASE_CONNECT_TIMEOUT_SECONDS=10

# Gere com: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=COLE_AQUI_UMA_CHAVE_ALEATORIA_COM_32_OU_MAIS_CARACTERES

# Mesmo domínio: deixe a URL do projeto Vercel em produção.
CORS_ORIGINS=https://SEU-PROJETO.vercel.app

# Primeiro deploy: você pode usar false para testar /health e o banco primeiro.
# Depois configure o ADMIN_* e altere para true para criar o administrador.
SEED_ADMIN=false
ADMIN_EMAIL=seu-email@dominio.com
ADMIN_PASSWORD=USE_UMA_SENHA_FORTE_COM_12_OU_MAIS_CARACTERES
ADMIN_NAME=Administrador

GOOGLE_MAPS_API_KEY=
